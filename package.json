{
  "name": "markdownlint-rule-spellcheck",
  "version": "0.1.0",
  "description": "A markdownlint custom rule for spelling checks powered by CSpell.",
  "type": "module",
  "main": "index.mjs",
  "exports": "./index.mjs",
  "bin": {
    "markdownlint-rule-spellcheck": "./cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "index.mjs",
    "front-matter.mjs",
    "cli.mjs",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "coverage": "c8 --all --include=index.mjs --include=cli.mjs --include=front-matter.mjs --reporter=text --reporter=lcov node --test",
    "test": "node --test"
  },
  "keywords": [
    "markdownlint-rule",
    "markdownlint",
    "markdown",
    "spellcheck",
    "cspell"
  ],
  "author": "Daniel Doubrovkine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/markdownlint-rule-spellcheck.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/markdownlint-rule-spellcheck/issues"
  },
  "homepage": "https://github.com/dblock/markdownlint-rule-spellcheck#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "markdownlint": ">=0.41.1"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.9",
    "@cspell/dict-software-terms": "^5.4.8",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.24.0",
    "markdownlint-rule-single-line-paragraphs": "^0.2.0"
  },
  "dependencies": {
    "@cspell/dict-en_us": "^4.4.43",
    "cspell-dictionary": "^10.4.0",
    "globby": "^16.2.4",
    "yaml": "^2.9.1"
  }
}
