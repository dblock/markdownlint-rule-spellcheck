{
  "name": "markdownlint-rule-spellcheck",
  "version": "0.1.0",
  "description": "A markdownlint custom rule for spelling checks powered by CSpell.",
  "type": "module",
  "main": "index.mjs",
  "exports": "./index.mjs",
  "files": [
    "CHANGELOG.md",
    "index.mjs",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint . && markdownlint-cli2 \"**/*.md\"",
    "test": "node --test"
  },
  "keywords": [
    "markdownlint-rule",
    "markdownlint",
    "markdown",
    "spellcheck",
    "cspell"
  ],
  "author": "Daniel Doubrovkine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/markdownlint-rule-spellcheck.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/markdownlint-rule-spellcheck/issues"
  },
  "homepage": "https://github.com/dblock/markdownlint-rule-spellcheck#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "markdownlint": ">=0.41.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.24.0"
  },
  "dependencies": {
